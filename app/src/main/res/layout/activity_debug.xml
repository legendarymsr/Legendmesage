<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tn_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debug_title"
            android:textColor="@color/tn_blue"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/debugInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/tn_surface"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/tn_fg"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <Button
            android:id="@+id/selfTestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/debug_selftest" />

        <Button
            android:id="@+id/diagnosticsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_diagnostics" />

        <Button
            android:id="@+id/crashButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_crash" />

        <Button
            android:id="@+id/copyOnionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_copy_onion" />

        <Button
            android:id="@+id/restartTorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/debug_restart_tor" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/debug_reset"
            android:textColor="#F7768E" />
    </LinearLayout>
</ScrollView>
